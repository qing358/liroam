<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 与上游 shop/lilishop 同一 Spring Boot 版本，依赖版本由同一 BOM 管理，避免进壳后出现两套版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.liroam</groupId>
    <artifactId>liroam-modules</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>liroam-common</module>
        <module>liroam-schema</module>
        <module>liroam-supplier-spi</module>
        <module>liroam-catalog</module>
        <module>liroam-supplier-mock</module>
        <module>liroam-pricing</module>
        <module>liroam-fulfillment</module>
        <module>liroam-shell-bridge</module>
        <module>liroam-architecture-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 上游 shop/lilishop/pom.xml 的 revision -->
        <lilishop.version>5.0.2</lilishop.version>
        <archunit.version>1.5.1</archunit.version>
        <bucket4j.version>8.22.0</bucket4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-common</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-supplier-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-supplier-spi</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-supplier-mock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-pricing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-fulfillment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.liroam</groupId>
                <artifactId>liroam-shell-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.lili</groupId>
                <artifactId>framework</artifactId>
                <version>${lilishop.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-mysql</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
