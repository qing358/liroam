# liroam 本机端口段（唯一登记处）。compose、scripts/dev.mjs、UI 运行时配置都只读这里。
# 本机 3306 / 6379 等端口属于其它项目，不得复用；改端口只改本文件。
COMPOSE_PROJECT_NAME=liroam

LIROAM_MYSQL_PORT=39306
LIROAM_REDIS_PORT=39379

LIROAM_MANAGER_API_PORT=39887
LIROAM_BUYER_API_PORT=39888

LIROAM_BUYER_UI_PORT=39000
LIROAM_SELLER_UI_PORT=39002
LIROAM_MANAGER_UI_PORT=39003
